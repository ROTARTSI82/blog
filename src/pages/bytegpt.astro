---
import Layout from '../layouts/Layout.astro';
import ByteGPTApp from '../components/2026/ByteGPT.tsx';

import inferWasmUrl from '../assets/2026/bytegpt/infer.wasm?url';
import inferJsUrl from '../assets/2026/bytegpt/infer.js?url';
import modelBinUrl from '../assets/2026/bytegpt/model_linux.bin?url';
---

<Layout title="ByteGPT Inference Engine">
  <script is:inline define:vars={{ inferWasmUrl }}>
    window.Module = {
      locateFile: function(path, prefix) {
        if (path === 'infer.wasm') return inferWasmUrl;
        return prefix + path;
      },
      onRuntimeInitialized: function() {
        window.dispatchEvent(new CustomEvent('wasmLoaded'));
      }
    };
  </script>
  <script is:inline src={inferJsUrl}></script>

  <h1 class="text-3xl font-bold mb-4 font-mono">ByteGPT</h1>
  <ByteGPTApp client:only="react" modelUrl={modelBinUrl} />
</Layout>
